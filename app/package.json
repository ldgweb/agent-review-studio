{
  "name": "agent-review-studio",
  "private": true,
  "version": "0.9.0",
  "description": "Local desktop workbench for reviewing changes made by coding agents.",
  "author": "Lucio (ldgweb)",
  "homepage": "https://github.com/ldgweb/agent-review-studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ldgweb/agent-review-studio.git",
    "directory": "app"
  },
  "bugs": {
    "url": "https://github.com/ldgweb/agent-review-studio/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "tauri": "tauri",
    "tauri:dev": "node scripts/stage-cli.mjs && tauri dev",
    "tauri:build": "tauri build",
    "ars": "cargo run --quiet --manifest-path src-tauri/Cargo.toml --bin ars --",
    "test": "node --test scripts/review.test.mjs",
    "audit:rust": "node scripts/audit-rust.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "refractor": "^5.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~5.6.3",
    "vite": "^8.3.3"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  }
}
